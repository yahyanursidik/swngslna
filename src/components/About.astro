---
import SectionHeading from './ui/SectionHeading.astro';
import { SITE } from '@/config/site';
import { SECTION, type Dictionary } from '@/i18n';
import { ahuDate } from '@/lib/legal';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const { about } = t;
---

<section id={SECTION.about} class="section border-t border-line" aria-labelledby="about-title">
  <div class="container-content grid gap-12 lg:grid-cols-[1.25fr_0.75fr] lg:gap-20">
    <div>
      <SectionHeading id="about-title" eyebrow={about.eyebrow} title={about.title} />
      <p class="mt-8 text-xl leading-relaxed font-medium lg:text-2xl lg:leading-snug">
        {about.lead}
      </p>
      <div class="mt-6 space-y-5 text-muted">
        {about.body.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </div>

    <aside aria-labelledby="about-facts-title" class="self-start lg:mt-14">
      <h3 id="about-facts-title" class="eyebrow">
        {about.factsLabel}
      </h3>
      <dl class="mt-4 divide-y divide-line border-y border-line">
        {about.facts.map((fact) => (
          <div class="grid grid-cols-[7.5rem_1fr] gap-4 py-4">
            <dt class="text-sm text-muted">{fact.label}</dt>
            <dd class="font-semibold">{fact.value}</dd>
          </div>
        ))}
        {SITE.legal.showAhu && (
          <div class="grid grid-cols-[7.5rem_1fr] gap-4 py-4">
            <dt class="text-sm text-muted">{about.legalLabel}</dt>
            <dd>
              <span class="font-semibold break-words">{SITE.legal.ahuNumber}</span>
              <span class="mt-0.5 block text-sm text-muted">{ahuDate(t.locale)}</span>
            </dd>
          </div>
        )}
      </dl>
    </aside>
  </div>

  <div class="container-content mt-16 lg:mt-20">
    <h3 class="text-xl font-bold">{about.principlesTitle}</h3>
    <ul
      class="mt-6 grid gap-px overflow-hidden rounded-card border border-line bg-line sm:grid-cols-2 lg:grid-cols-4"
      role="list"
    >
      {about.principles.map((p, i) => (
        <li class="bg-paper p-6 lg:p-7">
          <span class="text-sm font-bold text-teal-ink" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h4 class="mt-3 text-lg leading-snug font-bold">{p.title}</h4>
          <p class="mt-2 text-[0.9375rem] text-muted">{p.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
