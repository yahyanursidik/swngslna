---
import SectionHeading from './ui/SectionHeading.astro';
import { SECTION, type Dictionary } from '@/i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const { approach } = t;
const { toolbox } = approach;
---

<section id={SECTION.approach} class="section surface-dark" aria-labelledby="approach-title">
  <div class="container-content">
    <SectionHeading
      id="approach-title"
      eyebrow={approach.eyebrow}
      title={approach.title}
      lead={approach.lead}
    />

    <h3 class="sr-only">{approach.stagesLabel}</h3>
    <ol
      class="mt-14 grid gap-px overflow-hidden rounded-card bg-navy-soft sm:grid-cols-2 lg:grid-cols-3"
      role="list"
    >
      {approach.stages.map((stage, i) => (
        <li class="flex flex-col bg-navy p-6 ring-1 ring-white/10 lg:p-8">
          <div class="flex items-center gap-3">
            <span
              class="inline-flex size-9 items-center justify-center rounded-full border border-teal-soft/60 text-sm font-bold text-teal-soft tabular-nums"
              aria-hidden="true"
            >
              {i + 1}
            </span>
            <span class="h-px flex-1 bg-white/15" aria-hidden="true" />
          </div>
          <h4 class="mt-5 text-xl font-bold">{stage.title}</h4>
          <p class="mt-2 flex-1 text-[0.9375rem] leading-relaxed text-mist">{stage.text}</p>
          <p class="mt-5 text-sm">
            <span class="text-mist-dim">{approach.outputLabel}: </span>
            <span class="font-semibold text-paper">{stage.output}</span>
          </p>
        </li>
      ))}
    </ol>

    <div class="mt-20 grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <h3 class="text-2xl leading-tight font-bold sm:text-3xl">{toolbox.title}</h3>
        <p class="mt-4 text-lg text-mist">{toolbox.lead}</p>
        <p class="mt-8 border-l-[3px] border-sand pl-5 text-[0.9375rem] leading-relaxed text-mist">
          {toolbox.note}
        </p>
      </div>

      <ul class="grid gap-4 sm:grid-cols-2" role="list">
        {toolbox.frameworks.map((f) => (
          <li class="rounded-card border border-white/12 bg-navy-soft/60 p-5">
            <h4 class="font-bold text-paper">{f.name}</h4>
            <dl class="mt-3 space-y-3 text-sm leading-relaxed">
              <div>
                <dt class="font-semibold text-teal-soft">{toolbox.columns.use}</dt>
                <dd class="mt-0.5 text-mist">{f.use}</dd>
              </div>
              <div>
                <dt class="font-semibold text-sand">{toolbox.columns.guardrail}</dt>
                <dd class="mt-0.5 text-mist">{f.guardrail}</dd>
              </div>
            </dl>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
