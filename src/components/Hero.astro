---
import ArrowDown from '@lucide/astro/icons/arrow-down';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import HeroDiagram from './HeroDiagram.astro';
import { SITE } from '@/config/site';
import { SECTION, type Dictionary } from '@/i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const { hero } = t;
---

<section
  id={SECTION.top}
  class="relative overflow-hidden pt-12 pb-16 sm:pt-16 lg:pt-20 lg:pb-24"
  aria-labelledby="hero-title"
>
  <div class="container-content grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-10">
    <div>
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1
        id="hero-title"
        class="mt-6 text-[2.5rem] leading-[1.04] font-extrabold tracking-[-0.035em] sm:text-6xl lg:text-[3.75rem] xl:text-[4.5rem]"
      >
        <span class="block">{hero.titleLines[0]}</span>
        <span class="block text-teal-ink">{hero.titleLines[1]}</span>
      </h1>
      <p class="mt-7 max-w-2xl text-lg leading-relaxed text-muted sm:text-xl">{hero.support}</p>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a href={`#${SECTION.expertise}`} class="btn btn-primary">
          {hero.primaryCta}
          <ArrowDown class="size-[1.125rem]" aria-hidden="true" />
        </a>
        <a href={`#${SECTION.contact}`} class="btn btn-secondary">
          {hero.secondaryCta}
          <ArrowRight class="icon-shift size-[1.125rem]" aria-hidden="true" />
        </a>
      </div>

      <p class="mt-14 flex flex-col gap-1 border-t border-line pt-6 text-sm sm:flex-row sm:flex-wrap sm:gap-x-3">
        <span class="font-bold">{SITE.fullName}</span>
        <span class="hidden text-mist-dim sm:inline" aria-hidden="true">
          /
        </span>
        <span class="text-muted" lang="en">
          {SITE.descriptor}
        </span>
      </p>
    </div>

    <figure class="mx-auto w-full max-w-[34rem]">
      <HeroDiagram pillars={hero.pillars} />
      <figcaption class="mt-4 text-center text-sm text-muted">{hero.figureCaption}</figcaption>
    </figure>
  </div>
</section>
