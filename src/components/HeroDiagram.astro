---
/**
 * Original abstract diagram: three overlapping disciplines (PRD §1 positioning)
 * with the six-stage learning cycle at their intersection. No robots or brains (PRD §12).
 */
interface Props {
  pillars: [string, string, string];
}

const { pillars } = Astro.props;

const cx = 260;
const cy = 236;
const r = 50;
const nodes = Array.from({ length: 6 }, (_, i) => {
  const angle = (-90 + i * 60) * (Math.PI / 180);
  return { x: cx + r * Math.cos(angle), y: cy + r * Math.sin(angle), i };
});
---

<svg
  viewBox="0 0 520 500"
  class="h-auto w-full"
  role="img"
  aria-labelledby="hero-diagram-title"
  xmlns="http://www.w3.org/2000/svg"
>
  <title id="hero-diagram-title">{pillars.join(' × ')}</title>
  <defs>
    <pattern id="hero-dots" width="20" height="20" patternUnits="userSpaceOnUse">
      <circle cx="2" cy="2" r="1.3" fill="var(--color-mist)"></circle>
    </pattern>
    <radialGradient id="hero-fade" cx="50%" cy="50%" r="50%">
      <stop offset="55%" stop-color="white" stop-opacity="1"></stop>
      <stop offset="100%" stop-color="white" stop-opacity="0"></stop>
    </radialGradient>
    <mask id="hero-mask">
      <rect width="520" height="500" fill="url(#hero-fade)"></rect>
    </mask>
  </defs>

  <rect width="520" height="500" fill="url(#hero-dots)" mask="url(#hero-mask)"></rect>

  <!-- Disciplines -->
  <g fill-opacity="0.07" stroke-width="1.5">
    <circle cx="200" cy="200" r="130" fill="var(--color-navy)" stroke="var(--color-navy)"></circle>
    <circle cx="320" cy="200" r="130" fill="var(--color-teal)" stroke="var(--color-teal)"></circle>
    <circle cx="260" cy="304" r="130" fill="var(--color-sand)" stroke="var(--color-sand)"></circle>
  </g>

  <!-- Labels sit outside the circles so they never cross a stroke. -->
  <g font-size="15" font-weight="700" letter-spacing="-0.01em">
    <text x="40" y="44" fill="var(--color-navy)">
      {pillars[0]}
    </text>
    <text x="480" y="44" fill="var(--color-teal-ink)" text-anchor="end">
      {pillars[1]}
    </text>
    <text x="260" y="482" fill="var(--color-navy)" text-anchor="middle">
      {pillars[2]}
    </text>
  </g>
  <g stroke-width="1" stroke-dasharray="2 3">
    <line x1="70" y1="54" x2="112" y2="104" stroke="var(--color-navy)"></line>
    <line x1="450" y1="54" x2="408" y2="104" stroke="var(--color-teal)"></line>
    <line x1="260" y1="438" x2="260" y2="464" stroke="var(--color-sand)"></line>
  </g>

  <!-- Six-stage learning cycle -->
  <circle
    class="draw-path"
    cx={cx}
    cy={cy}
    r={r}
    fill="none"
    stroke="var(--color-navy)"
    stroke-width="1.5"
    pathLength="1"
    transform={`rotate(-90 ${cx} ${cy})`}
  ></circle>
  {nodes.map((n) => (
    <g class="fade-node" style={`animation-delay: ${0.35 + n.i * 0.18}s`}>
      <circle
        cx={n.x}
        cy={n.y}
        r={n.i === 0 ? 8 : 6}
        fill={n.i === 0 ? 'var(--color-teal-ink)' : 'var(--color-paper)'}
        stroke="var(--color-navy)"
        stroke-width="1.5"
      />
    </g>
  ))}
  <circle cx={cx} cy={cy} r="3.5" fill="var(--color-navy)"></circle>
</svg>
