---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import About from './About.astro';
import Challenges from './Challenges.astro';
import Expertise from './Expertise.astro';
import Platform from './Platform.astro';
import Approach from './Approach.astro';
import AILearning from './AILearning.astro';
import Industries from './Industries.astro';
import SelectedWork from './SelectedWork.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import { getDictionary, type Locale } from '@/i18n';
import { buildJsonLd } from '@/lib/structured-data';

interface Props {
  locale: Locale;
}

const t = getDictionary(Astro.props.locale);
---

<BaseLayout
  locale={t.locale}
  title={t.meta.title}
  description={t.meta.description}
  ogImage={t.meta.ogImage}
  ogImageAlt={t.meta.ogImageAlt}
  localizedHome
  jsonLd={buildJsonLd(t)}
>
  <Header t={t} />
  <main id="main" tabindex="-1" class="outline-none">
    <Hero t={t} />
    <About t={t} />
    <Challenges t={t} />
    <Expertise t={t} />
    <Platform t={t} />
    <Approach t={t} />
    <AILearning t={t} />
    <Industries t={t} />
    <SelectedWork t={t} />
    <Contact t={t} />
  </main>
  <Footer t={t} />
</BaseLayout>
