---
import Check from '@lucide/astro/icons/check';
import SectionHeading from './ui/SectionHeading.astro';
import PlatformFigure from './figures/PlatformFigure.astro';
import { SECTION, type Dictionary } from '@/i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const { platform } = t;
---

<section id={SECTION.platform} class="section bg-paper-alt" aria-labelledby="platform-title">
  <div class="container-content grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
    <div>
      <SectionHeading
        id="platform-title"
        eyebrow={platform.eyebrow}
        title={platform.title}
        lead={platform.lead}
      />
      <div class="mt-6 max-w-3xl space-y-5 text-muted">
        {platform.body.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </div>
    <PlatformFigure
      caption={platform.figure.caption}
      center={platform.figure.center}
      steps={platform.figure.steps}
    />
  </div>

  <div class="container-content mt-16">
    <h3 class="text-xl font-bold">{platform.valuesTitle}</h3>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
      {platform.values.map((value, i) => (
        <li class="rounded-card border border-line bg-white p-5 sm:p-6">
          <span class="text-sm font-bold text-teal-ink tabular-nums" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h4 class="mt-2 text-lg leading-snug font-bold">{value.title}</h4>
          <p class="mt-1.5 text-[0.9375rem] text-muted">{value.text}</p>
        </li>
      ))}
    </ul>
  </div>

  <div class="container-content mt-6">
    <div class="rounded-card border border-navy/15 bg-paper p-6 sm:p-8 lg:p-10">
      <h3 class="text-xl font-bold">{platform.capabilitiesTitle}</h3>
      <ul class="mt-6 grid gap-x-8 gap-y-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
        {platform.capabilities.map((item) => (
          <li class="flex gap-3 leading-snug">
            <Check
              class="mt-0.5 size-5 flex-none text-teal-ink"
              aria-hidden="true"
              stroke-width={2.25}
            />
            {item}
          </li>
        ))}
      </ul>
      <p class="mt-8 border-l-[3px] border-sand pl-5 text-[0.9375rem] text-muted">
        {platform.note}
      </p>
    </div>
  </div>
</section>
