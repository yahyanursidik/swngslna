---
import SectionHeading from './ui/SectionHeading.astro';
import { SECTION, type Dictionary } from '@/i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const { work } = t;
// FR-13: render only approved cases; omit the whole section when there are none.
const show = work.cases.length > 0;
---

{show && (
  <section id={SECTION.work} class="section bg-paper-alt" aria-labelledby="work-title">
    <div class="container-content">
      <SectionHeading id="work-title" eyebrow={work.eyebrow} title={work.title} lead={work.lead} />
      <ul class="mt-14 grid gap-6 md:grid-cols-2" role="list">
        {work.cases.map((c) => (
          <li class="flex flex-col rounded-card border border-line bg-white p-6 sm:p-8">
            {c.logo && (
              <img
                src={c.logo.src}
                alt={c.logo.alt}
                class="mb-6 h-10 w-auto object-contain object-left"
                loading="lazy"
                decoding="async"
              />
            )}
            <h3 class="text-xl leading-snug font-bold">{c.title}</h3>
            <dl class="mt-4 grid grid-cols-3 gap-4 border-y border-line py-4 text-sm">
              <div>
                <dt class="text-muted">{work.labels.client}</dt>
                <dd class="font-semibold">{c.client}</dd>
              </div>
              <div>
                <dt class="text-muted">{work.labels.sector}</dt>
                <dd class="font-semibold">{c.sector}</dd>
              </div>
              <div>
                <dt class="text-muted">{work.labels.year}</dt>
                <dd class="font-semibold">{c.year}</dd>
              </div>
            </dl>
            <p class="mt-4 flex-1 text-muted">{c.summary}</p>
            <h4 class="eyebrow mt-6">{work.labels.scope}</h4>
            <ul class="mt-3 flex flex-wrap gap-2" role="list">
              {c.scope.map((s) => (
                <li class="rounded-md bg-paper-alt px-2.5 py-1 text-[0.8125rem] font-medium">
                  {s}
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
