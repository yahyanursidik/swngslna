---
/**
 * Human-in-the-loop AI workflow inside a governance boundary (PRD §10).
 * Original diagram — no robots or brains (PRD §12).
 */
interface Props {
  caption: string;
  governance: string;
  steps: [string, string, string, string];
}

const { caption, governance, steps } = Astro.props;

const W = 164;
const H = 112;
const boxes = [
  { x: 40, y: 72 },
  { x: 236, y: 72 },
  { x: 236, y: 228 },
  { x: 40, y: 228 },
];
const center = (i: number) => ({ cx: boxes[i]!.x + W / 2, top: boxes[i]!.y });
---

<figure class="w-full">
  <svg
    viewBox="0 0 440 372"
    class="mx-auto h-auto w-full max-w-[30rem]"
    role="img"
    aria-labelledby="ai-figure-title"
  >
    <title id="ai-figure-title">{`${steps.join(' → ')}. ${caption}`}</title>
    <defs>
      <marker
        id="ai-arrow"
        viewBox="0 0 10 10"
        refX="7"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path d="M1 1L8 5L1 9" fill="none" stroke="var(--color-teal-ink)" stroke-width="1.8"></path>
      </marker>
      <marker
        id="ai-arrow-sand"
        viewBox="0 0 10 10"
        refX="7"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path d="M1 1L8 5L1 9" fill="none" stroke="#b9873f" stroke-width="1.8"></path>
      </marker>
    </defs>

    <!-- Governance boundary -->
    <text
      x="24"
      y="22"
      font-size="12"
      font-weight="700"
      letter-spacing="1.5"
      fill="var(--color-teal-ink)"
    >
      {governance}
    </text>
    <rect
      x="12"
      y="36"
      width="416"
      height="328"
      rx="24"
      fill="none"
      stroke="var(--color-teal)"
      stroke-width="1.5"
      stroke-dasharray="6 6"
    ></rect>

    {boxes.map((b, i) => (
      <rect
        x={b.x}
        y={b.y}
        width={W}
        height={H}
        rx="16"
        fill={i === 2 ? 'var(--color-navy)' : 'var(--color-white)'}
        stroke={i === 2 ? 'var(--color-navy)' : 'var(--color-line)'}
        stroke-width="1.5"
      />
    ))}

    <!-- 1. Approved sources: document -->
    <g transform={`translate(${center(0).cx - 14} ${center(0).top + 18})`}>
      <rect
        width="28"
        height="36"
        rx="4"
        fill="none"
        stroke="var(--color-navy)"
        stroke-width="2"
      ></rect>
      <path
        d="M7 11H21M7 18H21M7 25H16"
        stroke="var(--color-teal)"
        stroke-width="2"
        stroke-linecap="round"
      ></path>
    </g>

    <!-- 2. AI draft: sparkle -->
    <g transform={`translate(${center(1).cx} ${center(1).top + 36})`} fill="var(--color-teal)">
      <path d="M0 -18C2 -6 6 -2 18 0C6 2 2 6 0 18C-2 6 -6 2 -18 0C-6 -2 -2 -6 0 -18Z"></path>
      <path d="M17 -16C17.6 -12.6 18.4 -11.8 22 -11C18.4 -10.2 17.6 -9.4 17 -6C16.4 -9.4 15.6 -10.2 12 -11C15.6 -11.8 16.4 -12.6 17 -16Z"></path>
    </g>

    <!-- 3. Human review: person (sand dot = the human, as in the logo) -->
    <g transform={`translate(${center(2).cx} ${center(2).top + 18})`}>
      <circle cy="9" r="9" fill="var(--color-sand)"></circle>
      <path
        d="M-17 38C-17 27 -9 21 0 21C9 21 17 27 17 38"
        fill="none"
        stroke="var(--color-paper)"
        stroke-width="2.5"
        stroke-linecap="round"
      ></path>
    </g>

    <!-- 4. Ready to use: check -->
    <g transform={`translate(${center(3).cx} ${center(3).top + 36})`}>
      <circle r="17" fill="var(--color-teal-ink)"></circle>
      <path
        d="M-8 0l5.5 5.5L9 -6"
        fill="none"
        stroke="var(--color-white)"
        stroke-width="2.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      ></path>
    </g>

    {boxes.map((b, i) => (
      <text
        x={b.x + W / 2}
        y={b.y + 88}
        text-anchor="middle"
        font-size="15"
        font-weight="700"
        fill={i === 2 ? 'var(--color-paper)' : 'var(--color-navy)'}
      >
        {steps[i]}
      </text>
    ))}

    <!-- Flow -->
    <g stroke="var(--color-teal-ink)" stroke-width="2" stroke-linecap="round" fill="none">
      <path d="M208 128H230" marker-end="url(#ai-arrow)"></path>
      <path d="M318 188V222" marker-end="url(#ai-arrow)"></path>
      <path d="M232 284H210" marker-end="url(#ai-arrow)"></path>
    </g>
    <!-- Revision loop: review → draft -->
    <path
      d="M402 262C422 246 422 166 402 150"
      fill="none"
      stroke="#b9873f"
      stroke-width="2"
      stroke-dasharray="4 4"
      stroke-linecap="round"
      marker-end="url(#ai-arrow-sand)"
    ></path>
  </svg>
  <figcaption class="mt-3 text-center text-sm text-muted">{caption}</figcaption>
</figure>
