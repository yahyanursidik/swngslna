---
/**
 * Adult learning cycle around role & competency (experiential learning adapted to
 * the workplace). Original diagram; the sand dot is the learner moving through the cycle.
 */
interface Props {
  caption: string;
  center: [string, string];
  steps: [string, string, string, string];
}

const { caption, center, steps } = Astro.props;

const cx = 220;
const cy = 205;
const pills = [
  { x: cx, y: cy - 138 },
  { x: cx + 138, y: cy },
  { x: cx, y: cy + 138 },
  { x: cx - 138, y: cy },
];
// Clockwise arcs on the ring between the stage pills (r = 138).
const arcs = [
  'M284.8 83.2A138 138 0 0 1 352.7 167',
  'M352.7 243A138 138 0 0 1 284.8 326.8',
  'M155.2 326.8A138 138 0 0 1 87.3 243',
  'M87.3 167A138 138 0 0 1 155.2 83.2',
];
---

<figure class="w-full">
  <svg
    viewBox="0 0 440 410"
    class="mx-auto h-auto w-full max-w-[30rem]"
    role="img"
    aria-labelledby="platform-figure-title"
  >
    <title id="platform-figure-title">{`${center.join(' ')}: ${steps.join(' → ')}`}</title>
    <defs>
      <marker
        id="pf-arrow"
        viewBox="0 0 10 10"
        refX="7"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path d="M1 1L8 5L1 9" fill="none" stroke="var(--color-teal-ink)" stroke-width="1.8"></path>
      </marker>
    </defs>

    <circle
      cx={cx}
      cy={cy}
      r="138"
      fill="none"
      stroke="var(--color-line)"
      stroke-width="10"
      stroke-opacity="0.7"
    ></circle>
    {arcs.map((d) => (
      <path
        d={d}
        fill="none"
        stroke="var(--color-teal)"
        stroke-width="2.5"
        stroke-linecap="round"
        marker-end="url(#pf-arrow)"
      />
    ))}

    <!-- Learner on the way -->
    <circle
      cx="325.7"
      cy="116.3"
      r="9"
      fill="var(--color-sand)"
      stroke="var(--color-white)"
      stroke-width="3"
    ></circle>

    <!-- Centre: role & competency -->
    <circle cx={cx} cy={cy} r="66" fill="var(--color-navy)"></circle>
    <circle cx={cx} cy={cy - 30} r="7" fill="var(--color-sand)"></circle>
    <text x={cx} text-anchor="middle" font-size="16" font-weight="700" fill="var(--color-paper)">
      <tspan x={cx} y={cy + 4}>
        {center[0]}
      </tspan>
      <tspan x={cx} y={cy + 24}>
        {center[1]}
      </tspan>
    </text>

    {pills.map((p, i) => {
      const highlight = i === 3;
      return (
        <g>
          <rect
            x={p.x - 60}
            y={p.y - 21}
            width="120"
            height="42"
            rx="21"
            fill={highlight ? 'var(--color-teal-ink)' : 'var(--color-white)'}
            stroke={highlight ? 'var(--color-teal-ink)' : 'var(--color-navy)'}
            stroke-width="1.5"
          />
          <text
            x={p.x}
            y={p.y + 5.5}
            text-anchor="middle"
            font-size="16"
            font-weight="700"
            fill={highlight ? 'var(--color-white)' : 'var(--color-navy)'}
          >
            {steps[i]}
          </text>
        </g>
      );
    })}
  </svg>
  <figcaption class="mt-3 text-center text-sm text-muted">{caption}</figcaption>
</figure>
