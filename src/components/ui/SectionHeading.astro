---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  lead?: string;
  class?: string;
}
const { id, eyebrow, title, lead, class: className } = Astro.props;
---

<header class:list={['max-w-3xl', className]}>
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={id} class="mt-4 text-3xl leading-[1.12] font-bold sm:text-4xl lg:text-[2.875rem]">
    {title}
  </h2>
  {lead && <p class="mt-5 text-lg leading-relaxed opacity-85 lg:text-xl">{lead}</p>}
</header>
