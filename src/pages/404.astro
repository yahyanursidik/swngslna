---
/**
 * Static hosts serve a single /404.html, so this page carries both locales and
 * shows the one matching the requested path (/en/... → English, otherwise Indonesian).
 * Without JavaScript both versions are shown.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Logo from '@/components/ui/Logo.astro';
import { SITE } from '@/config/site';
import { LOCALES, LOCALE_META, getDictionary, homePath } from '@/i18n';

const id = getDictionary('id');
---

<BaseLayout
  locale="id"
  title={`404 — ${id.notFound.title} | ${SITE.shortName}`}
  description={id.notFound.text}
  ogImage={id.meta.ogImage}
  ogImageAlt={id.meta.ogImageAlt}
  noindex
>
  <header class="border-b border-line">
    <div class="container-content flex h-[4.5rem] items-center">
      <a href="/id/" class="rounded-sm no-underline" data-home-link>
        <Logo />
        <span class="sr-only">
          {SITE.shortName} — {SITE.fullName}
        </span>
      </a>
    </div>
  </header>

  <main id="main" class="container-content grid gap-16 py-20 sm:py-28">
    {LOCALES.map((l) => {
      const t = getDictionary(l);
      return (
        <section lang={LOCALE_META[l].htmlLang} data-locale-block={l} class="max-w-2xl">
          <p class="eyebrow">404</p>
          <h1 class="mt-4 text-4xl leading-tight font-extrabold sm:text-5xl">{t.notFound.title}</h1>
          <p class="mt-5 text-lg text-muted">{t.notFound.text}</p>
          <a href={homePath(l)} class="btn btn-primary mt-8">
            {t.notFound.cta}
          </a>
        </section>
      );
    })}
  </main>
</BaseLayout>

<script>
  const locale = window.location.pathname.startsWith('/en') ? 'en' : 'id';
  document.documentElement.lang = locale;
  document.querySelectorAll<HTMLElement>('[data-locale-block]').forEach((block) => {
    block.hidden = block.dataset.localeBlock !== locale;
    const heading = block.querySelector('h1');
    if (!block.hidden && heading) document.title = `404 — ${heading.textContent?.trim()} | STS`;
  });
  document
    .querySelector<HTMLAnchorElement>('[data-home-link]')
    ?.setAttribute('href', `/${locale}/`);
</script>
